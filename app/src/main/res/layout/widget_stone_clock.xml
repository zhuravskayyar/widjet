<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/widget_hour_tens"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/digit_1" />

    <ImageView
        android:id="@+id/widget_hour_ones"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginStart="3dp"
        android:scaleType="fitCenter"
        android:src="@drawable/digit_7" />

    <ImageView
        android:id="@+id/widget_colon"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginStart="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/digit_colon" />

    <ImageView
        android:id="@+id/widget_minute_tens"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginStart="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/digit_2" />

    <ImageView
        android:id="@+id/widget_minute_ones"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:layout_marginStart="3dp"
        android:scaleType="fitCenter"
        android:src="@drawable/digit_8" />
</LinearLayout>
